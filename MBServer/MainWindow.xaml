<Window x:Class="MBServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MBServer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Navy">
        <TextBox Background="Navy" Foreground="Red" FontSize="72" FontFamily="Comic Sans MS" HorizontalAlignment="Right" Height="217" TextWrapping="Wrap" Text="Miku Miku Beam" VerticalAlignment="Top" Width="679" TextChanged="TextBox_TextChanged"/>
        <Button Height="64" Width="512" TextBlock.FontFamily="Comic Sans Ms" TextBlock.FontSize="32" TextBlock.Foreground="Navy" Background="Red">Fire Jewish Space Laser</Button>
    </Grid>
</Window>
